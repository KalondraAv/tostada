programa
{
	
	funcao inicio()
	{
		// PROGRAMA PARA CALCULAR IDADE
		inteiro anoNascimento, anoAtual, idade
		caracter arroba, inicialNome
		cadeia nome, usuario 
		anoNascimento = 2009
		anoAtual = 2025
		idade = anoAtual - anoNascimento
		arroba = '@'
		inicialNome = 'K'
		nome = "Kalondra"
		usuario = "ghb_kaa"
		escreva("Meu nome é " + nome + " e tenho " + idade + " anos." + " \nA letra inicial do meu nome é " + inicialNome + ". \nVocê pode me encontrar no instagram como " + arroba + usuario + ".")
	}
}
